# Configuração de conexão com Oracle
ORACLE_USER=usuario_teste
ORACLE_PASSWORD=senha_teste
ORACLE_HOST=host.oracle.local
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=SERVICE
ORACLE_TABLE=TABELA_COMPROMISSO

# Spark (ajustar o caminho do driver JDBC)
ORACLE_JAR_PATH=/caminho/para/ojdbc8.jar
ORACLE_BATCHSIZE=5000
ORACLE_NUM_PARTITIONS=4

# Pandas
ORACLE_CHUNK_SIZE=5000
