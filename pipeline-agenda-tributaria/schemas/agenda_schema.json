{
  "type": "object",
  "properties": {
    "fonte": { "type": "string" },
    "extraido_em": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "ano": { "type": "integer" },
    "meses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "mes": { "type": "integer" },
          "nome": { "type": "string" },
          "url": { "type": ["string", "null"] },
          "dias": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "url": { "type": ["string", "null"] },
                "publicado_em": { "type": "string" },
                "atualizado_em": { "type": "string" },
                "eventos": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "tipo": { "type": "string" },
                      "codigo_receita": { "type": ["string", "null"] },
                      "descricao": { "type": "string" },
                      "periodo_fato_gerador": { "type": ["string", "null"] },
                      "grupo_tributo": { "type": ["string", "null"] },
                      "documento_arrecadacao": { "type": ["string", "null"] },
                      "documento_arrecadacao_url": { "type": ["string", "null"] },
                      "categoria_declaracao": { "type": ["string", "null"] },
                      "origem_escrituracao": { "type": ["string", "null"] },
                      "fundamentacao_legal": { "type": ["string", "null"] },
                      "fundamentacao_legal_url": { "type": ["string", "null"] }
                    },
                    "required": ["tipo", "descricao"]
                  }
                }
              },
              "required": ["data", "url", "publicado_em", "atualizado_em", "eventos"]
            }
          }
        },
        "required": ["mes", "nome", "dias"]
      }
    }
  },
  "required": ["fonte", "extraido_em", "ano", "meses"]
}
