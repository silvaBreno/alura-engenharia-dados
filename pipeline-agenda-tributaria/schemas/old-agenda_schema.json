{
  "type": "object",
  "properties": {
    "fonte": { "type": "string" },
    "extraido_em": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "ano": { "type": "integer" },
    "meses": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "url": { "type": "string" },
          "dias": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "url": { "type": "string" },
                "eventos": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "tipo": { "type": "string" },
                      "codigo_darf": { "type": ["string", "null"] },
                      "codigo_gps": { "type": ["string", "null"] },
                      "documento": { "type": ["string", "null"] },
                      "descricao": { "type": "string" },
                      "periodo_fato_gerador": { "type": ["string", "null"] }
                    },
                    "required": ["tipo", "descricao"]
                  }
                }
              },
              "required": ["url", "eventos"]
            }
          }
        },
        "required": ["url", "dias"]
      }
    }
  },
  "required": ["fonte", "extraido_em", "ano", "meses"]
}
